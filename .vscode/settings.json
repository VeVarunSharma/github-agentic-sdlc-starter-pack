// Workspace editor + Copilot settings for the Agentic SDLC Starter Pack.
// See https://code.visualstudio.com/docs/copilot/reference/copilot-settings
{
  // --- Editor baseline ---
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // --- Copilot ---
  // Have Copilot Chat read .github/instructions/*.instructions.md and
  // .github/copilot-instructions.md (which APM regenerates from AGENTS.md).
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,

  // Auto-discover MCP servers configured in .vscode/mcp.json.
  "chat.mcp.discovery.enabled": true,

  // Require explicit confirmation before chat tools / MCP tools execute. Keep
  // this OFF for any repo that touches infra or secrets.
  "chat.tools.autoApprove": false,

  // --- Per-language overrides ---
  "[terraform]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.tabSize": 2
  },
  "[terraform-vars]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.tabSize": 2
  },
  "[markdown]": {
    // Disabled for now to avoid noisy reformatting in PR diffs.
    "editor.formatOnSave": false
  },
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[yaml]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },

  // --- Files / search hygiene ---
  "files.exclude": {
    "**/.terraform": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/.terraform": true,
    "**/node_modules": true,
    "**/apm.lock.yaml": false
  }
}
