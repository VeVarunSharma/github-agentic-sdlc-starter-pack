{
  "name": "agentic-sdlc-sample-app",
  "version": "0.1.0",
  "description": "Enterprise control-plane showcase for the GitHub Agentic SDLC Starter Pack.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --import @azure/monitor-opentelemetry/loader --import ./src/telemetry.js ./src/server.js",
