subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "eastus"
region_short    = "eus"
environment     = "prod"
workload_name   = "sdlcstarter"

github_owner    = "<owner>"
github_owner_id = "1234567"
github_repo     = "<repo>"
github_repo_id  = "7654321"

# Immutable is required for repositories created, renamed, or transferred
# after 2026-07-15. Set legacy only for an older repository whose GitHub OIDC
# token still emits repo:OWNER/REPO subjects.
oidc_subject_mode = "immutable"

# These globally unique names are generated by scripts/setup-azure-oidc.sh
# from stable subscription, owner, and repository IDs.
state_storage_account_name = "stsdlcprod1234abcd"
acr_name                   = "crsdlcstarterprod1234abcd"
web_app_name               = "app-sdlcstarter-prod-eus-1234abcd"

# State protection defaults:
# enable_state_delete_lock      = true
# state_soft_delete_days        = 30
# state_version_retention_days  = 90
